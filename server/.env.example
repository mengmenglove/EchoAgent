# 复制为 server/.env 后修改。没有默认值的项必须填写，否则启动失败。

ENV=dev

# 本地开发：SQLite 文件（server/echo.db），不用装数据库
DATABASE_URL=sqlite+aiosqlite:///./echo.db
# 上线换成 Postgres：
# DATABASE_URL=postgresql+asyncpg://echo:echo@127.0.0.1:5432/echo

# 留空 = 不用 Redis：任务在 API 进程里执行，不需要启动 worker
# 上线要多进程时再配，并单独启动 make worker：
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# 至少 32 位的随机字符串：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Claude API（需求模式需要；文案直出模式不需要）
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# 经过代理网关（ANTHROPIC_BASE_URL）时，如果报 400 不认识 fallbacks 参数，改成 false
LLM_FALLBACKS=true

# 聊天功能：本地 Ollama（make ollama 启动，make ollama-pull 下载模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen3.5:4b

# f5 = 本地 F5-TTS 服务；mock = 生成提示音，用于没有 F5 时调试整条链路
TTS_PROVIDER=f5
F5_BASE_URL=http://127.0.0.1:8765

STORAGE_BACKEND=local
# STORAGE_BACKEND=s3
# S3_BUCKET=echo-agent
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# 质检（需要先 uv add mlx-whisper）
VERIFY_ENABLED=false
